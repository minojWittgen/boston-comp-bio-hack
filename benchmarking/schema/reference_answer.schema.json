{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xctx-eval/reference_answer",
  "title": "Held-out reference answer (grader only)",
  "description": "Lives OUTSIDE any path the agent can read. One entry per case. Grader fills the scorecard from this without seeing which configuration produced the output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "situation",
    "accepted_verdicts",
    "must_cite",
    "must_detect",
    "must_not",
    "scorecard_rows",
    "fixture_construction"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^xctx-[0-9]{3}$"
    },
    "situation": {
      "enum": [
        "dev_example",
        "valid_corroboration",
        "invalid_patient_pairing",
        "recoverable_missing_then_disagreement"
      ]
    },
    "accepted_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "persists",
          "partially_persists",
          "diverges",
          "not_comparable"
        ]
      }
    },
    "must_cite": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "why"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "locator_hint": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "must_detect": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Facts that must appear (in substance, not verbatim) in caveats or rationale."
    },
    "must_not": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Behaviours that fail the case outright."
    },
    "scorecard_rows": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row",
          "pass_if"
        ],
        "properties": {
          "row": {
            "enum": [
              "conclusion",
              "evidence",
              "completion",
              "retrieval",
              "reporting_after_recovery"
            ]
          },
          "pass_if": {
            "type": "string"
          }
        }
      }
    },
    "fixture_construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_package",
        "context_datasets",
        "tool_stub"
      ],
      "properties": {
        "evidence_package": {
          "type": "string",
          "description": "How to derive/modify the frozen package for this case (which source statuses to set)."
        },
        "context_datasets": {
          "type": "string",
          "description": "How to construct the in-vitro/patient fixtures so the trap (or absence of trap) exists."
        },
        "tool_stub": {
          "type": "string",
          "description": "What build_evidence_package must return if called during this case."
        }
      }
    },
    "must_detect_keywords": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "regexes per must_detect item; grade.py uses them for the auto pass, a human confirms."
    }
  }
}
