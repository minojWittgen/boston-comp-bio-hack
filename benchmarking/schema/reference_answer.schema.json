{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmarking/reference_answer",
  "title": "Held-out reference answer (grader only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "situation", "expected_axes", "accepted_overall", "must_cite", "required_actions", "forbidden", "status_interpretation_expected", "must_detect", "fixture_construction"],
  "properties": {
    "case_id": { "type": "string" },
    "situation": { "enum": ["dev_example", "genuine_scoped_agreement", "invalid_within_person_pairing", "recoverable_required_observation_changes_axis"] },
    "expected_axes": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["accepted_verdicts", "required_evidence"],
        "properties": {
          "accepted_verdicts": { "type": "array", "items": { "enum": ["persists", "partially_persists", "diverges", "not_assessable"] } },
          "required_evidence": { "type": "array", "items": { "type": "string" }, "description": "observation_ids / reference keys the axis verdict must rest on (exact match, no substitutes)" },
          "forbidden_verdicts": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string" }
        }
      }
    },
    "accepted_overall": { "type": "array", "items": { "enum": ["persists", "partially_persists", "diverges", "not_assessable"] } },
    "must_cite": { "type": "array", "items": { "type": "object", "required": ["source", "why"], "properties": { "source": { "type": "string" }, "locator_must_resolve": { "type": "boolean" }, "why": { "type": "string" } } } },
    "required_actions": { "type": "array", "items": { "type": "object", "required": ["tool", "args_subset", "max_calls"], "properties": { "tool": { "type": "string" }, "args_subset": { "type": "object" }, "min_calls": { "type": "integer" }, "max_calls": { "type": "integer" } } } },
    "forbidden": { "type": "array", "items": { "type": "string" }, "description": "machine-checkable rule ids implemented in grade.py" },
    "status_interpretation_expected": { "type": "object", "additionalProperties": { "type": "string" } },
    "must_detect": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "text", "mandatory"], "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "mandatory": { "type": "boolean", "description": "mandatory items need a human confirm before a run can count as passed" }, "keywords": { "type": "array", "items": { "type": "string" } } } }
    },
    "fixture_construction": { "type": "object" }
  }
}
