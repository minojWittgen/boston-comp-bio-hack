{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmarking/case_manifest",
  "title": "Case manifest (identical shape for every configuration; carries no expected result)",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "schema_version", "mode", "task", "gene", "evidence_package", "datasets", "input_allowlist", "tools", "limits"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^(xctx-[0-9]{3}|lit-[0-9]{2})$" },
    "_note": { "type": "string", "description": "dev example only" },
    "schema_version": { "const": "2.0" },
    "mode": { "enum": ["explore", "eval"] },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "claim_contrast", "axes", "instruction", "checklist", "output_schema"],
      "properties": {
        "claim": { "type": "string", "description": "A precisely defined DIRECTIONAL expression comparison — gene, endpoint, contrast, direction. Not a pathway/state claim." },
        "claim_contrast": {
          "type": "object", "additionalProperties": false,
          "required": ["gene", "endpoint", "direction", "origin_dataset"],
          "properties": { "gene": { "type": "string" }, "endpoint": { "type": "string" }, "direction": { "enum": ["up", "down"] }, "origin_dataset": { "type": "string" } }
        },
        "axes": {
          "type": "array", "minItems": 1,
          "description": "The comparisons the agent must answer, each with the datasets it may draw on and, for within-person axes, the explicit matched-subject requirement.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["axis_id", "question", "datasets", "requires_matched_participants"],
            "properties": {
              "axis_id": { "enum": ["in_vitro_vs_in_vivo", "in_vitro_vs_patient_rna", "patient_rna_vs_patient_protein_within_person", "literature_axis"] },
              "question": { "type": "string" },
              "datasets": { "type": "array", "items": { "type": "string" } },
              "requires_matched_participants": { "type": "boolean" }
            }
          }
        },
        "instruction": { "type": "string" },
        "checklist": { "type": "array", "items": { "type": "string" }, "description": "The SAME checklist is given to every configuration in prose (review §'small, fair demonstration'). Enforced configurations additionally must evidence each item." },
        "output_schema": { "type": "string" }
      }
    },
    "gene": { "type": "object", "additionalProperties": false, "required": ["symbol", "disease"], "properties": { "symbol": { "type": "string" }, "disease": { "type": "string" } } },
    "evidence_package": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "run_id", "produced_by", "role"],
      "properties": {
        "path": { "type": "string" }, "run_id": { "type": "string" },
        "produced_by": { "const": "xctx-evidence.build_package" },
        "role": { "const": "reference_context", "description": "GTEx/orthology/IMPC are BACKGROUND (reference abundance, species mapping, knockout phenotype). They are not disease-contrast observations and never decide an axis on their own." }
      }
    },
    "datasets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "context", "species", "modality", "path", "status", "required"],
        "properties": {
          "id": { "type": "string" }, "context": { "enum": ["in_vitro", "in_vivo", "patient", "literature"] },
          "species": { "type": "string" }, "modality": { "enum": ["rna", "protein", "phenotype", "narrative"] },
          "path": { "type": "string" }, "status": { "enum": ["available", "unavailable"] },
          "required": { "type": "boolean", "description": "true = an axis cannot be assessed without it; if unavailable, the declared retry policy is: call fetch_dataset once." }
        }
      }
    },
    "input_allowlist": { "type": "array", "items": { "type": "string" }, "description": "Exactly the files read_file may open, relative to the manifest. Nothing else in the fixture directory is readable (tool stubs, recovery payloads, originals)." },
    "tools": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "stub_responses", "retry_policy"],
      "properties": {
        "available": { "type": "array", "items": { "enum": ["read_file", "fetch_dataset", "build_evidence_package"] } },
        "stub_responses": { "type": "string" },
        "retry_policy": { "type": "string" }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_data_tool_calls", "max_bookkeeping_calls", "max_output_tokens_total", "max_output_tokens_per_call", "wall_clock_seconds"],
      "properties": {
        "max_data_tool_calls": { "type": "integer", "minimum": 0, "description": "read_file + fetch_dataset + build_evidence_package" },
        "max_bookkeeping_calls": { "type": "integer", "minimum": 0, "description": "update_criteria etc. — counted separately, definition is explicit for every system" },
        "max_output_tokens_total": { "type": "integer", "minimum": 1, "description": "CUMULATIVE across all model calls in the run" },
        "max_output_tokens_per_call": { "type": "integer", "minimum": 1 },
        "wall_clock_seconds": { "type": "integer", "minimum": 1, "description": "Hard deadline for the whole run; every model request is bounded by the remaining time." }
      }
    }
  }
}
