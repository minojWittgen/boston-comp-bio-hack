{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xctx-eval/case_manifest",
  "title": "Cross-context evidence case manifest",
  "description": "Shared by Configuration A and Configuration B. Carries NO expected result. Every case uses the same shape so the situation under test cannot be inferred from structure alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "schema_version",
    "mode",
    "task",
    "gene",
    "evidence_package",
    "context_datasets",
    "tools",
    "limits"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(xctx-[0-9]{3}|lit-[0-9]{2})$",
      "description": "Neutral, non-descriptive identifier."
    },
    "_note": {
      "type": "string",
      "description": "Permitted ONLY on the development example (xctx-000). Final cases must omit it."
    },
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "explore",
        "eval"
      ],
      "description": "Pipeline mode used to build the evidence package. Final cases must be 'eval' (pubmed + opentargets skipped so benchmark answers cannot leak)."
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "instruction",
        "allowed_verdicts",
        "output_schema"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "description": "The ONE pathway/gene claim fixed in Step 1. Identical wording across all cases."
        },
        "instruction": {
          "type": "string",
          "description": "What the agent is asked to do. Identical across cases."
        },
        "allowed_verdicts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "persists",
              "partially_persists",
              "diverges",
              "not_comparable"
            ]
          }
        },
        "output_schema": {
          "type": "string",
          "description": "Relative path to agent_output.schema.json."
        }
      }
    },
    "gene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "disease"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Human HGNC symbol, as passed to build_package."
        },
        "disease": {
          "type": "string"
        }
      }
    },
    "evidence_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "run_id",
        "produced_by"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path to the frozen evidence_package JSON emitted by package.build_package."
        },
        "run_id": {
          "type": "string"
        },
        "produced_by": {
          "const": "xctx-evidence.build_package"
        }
      }
    },
    "context_datasets": {
      "type": "array",
      "minItems": 1,
      "description": "Hackathon fixtures (NOT produced by the pipeline). The pipeline package supplies the cross-species/reference layer; these supply the in-vitro and patient layers. Every case ships the same set of context/modality slots.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "context",
          "modality",
          "path",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "context": {
            "enum": [
              "in_vitro",
              "in_vivo",
              "patient"
            ]
          },
          "modality": {
            "enum": [
              "rna",
              "protein",
              "phenotype",
              "narrative"
            ]
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Neutral one-line description. Must not hint at the expected outcome."
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_file",
              "build_evidence_package"
            ]
          },
          "description": "Same list in every case. build_evidence_package(symbol, disease, mode) is the MCP tool; in a case it is served from a stub that returns the fixture at tools.stub_responses."
        },
        "stub_responses": {
          "type": "string",
          "description": "Relative path to a JSON map of tool-call -> canned response, so both configurations see identical tool behaviour."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tool_calls",
        "max_output_tokens",
        "wall_clock_seconds"
      ],
      "properties": {
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Frozen from the development example (Step 4). Set on Configuration B's dev run; A gets the same budget."
    }
  }
}
